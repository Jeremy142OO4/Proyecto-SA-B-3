{
  "uid": "bank-usac-prueba1",
  "title": "Bank USAC-Prueba1",
  "schemaVersion": 39,
  "version": 5,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bank-usac",
    "customer-service",
    "prueba1",
    "account-service"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bank_kyc_customers{service=\"customer-service\"}, environment)",
          "refId": "EnvironmentVariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "accountId",
        "label": "UUID de cuenta (.* = todas)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01/Customer_Service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Clientes verificados vs rechazados",
      "description": "Cantidad actual de clientes por estado KYC en la base. Incluye clientes anteriores y sobrevive reinicios. Se usa max para evitar duplicar el total compartido entre réplicas. Sin datos significa falta de telemetría; no equivale a cero clientes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (bank_kyc_customers{service=\"customer-service\",environment=\"$environment\",status=~\"VERIFIED|REJECTED\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VERIFIED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Verificados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REJECTED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rechazados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Creación → primera verificación KYC · p95 (24 h)",
      "description": "Percentil 95 estimado del histograma de tiempo desde creación hasta primera verificación. Cada punto utiliza verificaciones observadas en las últimas 24 horas, sumando buckets entre réplicas antes de calcular el percentil. No es duración de una consulta SQL ni promedio. Sin muestras aparece sin datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bank_kyc_duration_seconds_bucket{service=\"customer-service\",environment=\"$environment\"}[24h])))",
          "legendFormat": "Tiempo KYC p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 2,
          "noValue": "Sin verificaciones observadas",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trazas de creación y decisión KYC",
      "description": "Una fila por Trace ID, con creación y decisión KYC agrupadas. Expandir la fila para ver los spans y abrir el Trace ID para consultar el recorrido completo en Explore. El aviso root span not yet received puede aparecer en metadatos de búsqueda aunque la raíz esté disponible al abrir la traza.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"customer-service\" && resource.deployment.environment.name = \"$environment\" && name =~ \"customer[.]lifecycle[.](created|kyc)\" }",
          "limit": 20,
          "tableType": "traces",
          "spss": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "02/Account_service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Operaciones por tipo de cuenta · rango seleccionado",
      "description": "Número estimado de movimientos confirmados durante el rango seleccionado. CREDITO = entrada de dinero; DEBITO = salida. Se agrupan cuentas AHORRO y CORRIENTE y se suman réplicas. increase corrige reinicios y puede producir fracciones por extrapolación. La selección del UUID solo afecta el historial inferior. MONETARIA es un tipo legado excluido de estas cuatro combinaciones. Sin telemetría no se inventan ceros.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account_type, direction) (increase(bank_account_movements_total{service=\"account-service\",environment=\"$environment\",account_type=~\"AHORRO|CORRIENTE\",direction=~\"DEBITO|CREDITO\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{account_type}} · {{direction}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Field",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Entradas y salidas por minuto · cuenta(s): $accountId",
      "description": "Pegar el UUID de cuenta en el campo superior. Cada punto cuenta logs de movimientos confirmados de esa cuenta durante el minuto anterior. CREDITO = entrada, DEBITO = salida. No muestra montos ni saldo, y no usa el UUID como etiqueta de Prometheus. Solo hay historial recogido y retenido en Loki (48 h). La ausencia de puntos puede significar falta de operaciones o de logs. Con .* se consultan todas las cuentas del entorno; pegar un UUID para consultar solo esa cuenta. El UUID es un filtro de regex (usar .* para todas). El agrupamiento por accountId se calcula al consultar logs; no modifica las etiquetas indexadas ni Prometheus.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (accountId) (count_over_time({service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId=~\"${accountId:raw}\" | operation=\"CREDITO\" [1m]))",
          "queryType": "range",
          "legendFormat": "Entradas · crédito · {{accountId}}"
        },
        {
          "refId": "B",
          "expr": "sum by (accountId) (count_over_time({service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId=~\"${accountId:raw}\" | operation=\"DEBITO\" [1m]))",
          "queryType": "range",
          "legendFormat": "Salidas · débito · {{accountId}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "points",
            "showPoints": "always",
            "pointSize": 7,
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Entradas.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Salidas.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "type": "logs",
      "title": "Historial observable de operaciones · cuenta(s): $accountId",
      "description": "Logs originales de movimientos confirmados para el UUID seleccionado: fecha, accountId, accountType, operation, correlationId y traceId cuando existen. Expandir una línea para ver los campos. No equivale al libro persistido de movimientos: para montos/saldos e historial anterior a la recolección usar el endpoint autenticado de movimientos. Con .* se consultan todas las cuentas del entorno; pegar un UUID para consultar solo esa cuenta.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId=~\"${accountId:raw}\" | operation=~\"DEBITO|CREDITO\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 24,
      "type": "logs",
      "title": "Alertas AccountAnomalyDetected · WARNING",
      "description": "Logs de anomalías por alta frecuencia, en el entorno seleccionado. El evento durable y su notificación se consultan en auditoría; este panel evidencia el log emitido después del commit. No bloquea cuentas automáticamente.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"AccountAnomalyDetected\" | json eventType=\"eventType\", level=\"level\" | __error__=\"\" | eventType=\"AccountAnomalyDetected\" | level=\"WARNING\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
