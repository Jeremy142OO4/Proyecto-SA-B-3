{
  "uid": "bank-usac-prueba1",
  "title": "Bank USAC-Prueba1",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bank-usac",
    "customer-service",
    "prueba1"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bank_kyc_customers{service=\"customer-service\"}, environment)",
          "refId": "EnvironmentVariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "traceId",
        "label": "Trace ID del cliente",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01/Customer_Service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Clientes verificados vs rechazados",
      "description": "Cantidad actual de clientes por estado KYC en la base. Incluye clientes anteriores y sobrevive reinicios. Se usa max para evitar duplicar el total compartido entre réplicas. Sin datos significa falta de telemetría; no equivale a cero clientes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (bank_kyc_customers{service=\"customer-service\",environment=\"$environment\",status=~\"VERIFIED|REJECTED\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VERIFIED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Verificados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REJECTED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rechazados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Creación → primera verificación KYC · p95 (24 h)",
      "description": "Percentil 95 estimado del histograma de tiempo desde creación hasta primera verificación. Cada punto utiliza verificaciones observadas en las últimas 24 horas, sumando buckets entre réplicas antes de calcular el percentil. No es duración de una consulta SQL ni promedio. Sin muestras aparece sin datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bank_kyc_duration_seconds_bucket{service=\"customer-service\",environment=\"$environment\"}[24h])))",
          "legendFormat": "Tiempo KYC p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 2,
          "noValue": "Sin verificaciones observadas",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trazas de creación y decisión KYC",
      "description": "Busca spans de ciclo de vida, excluyendo consultas periódicas del outbox. Una decisión KYC también puede ser rechazo. Seleccionar Ver ciclo del cliente para cargar la traza abajo; verificar el evento y el estado VERIFIED para evidenciar una verificación. Ampliar el rango si la creación fue anterior.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"customer-service\" && resource.deployment.environment.name = \"$environment\" && name =~ \"customer[.]lifecycle[.](created|kyc)\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver ciclo del cliente",
                    "url": "/d/bank-usac-prueba1?${__url_time_range}&var-environment=${environment:percentencode}&var-traceId=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Ciclo del cliente · traza seleccionada",
      "description": "Seleccionar una traza en la tabla o pegar su Trace ID en el selector superior. Revisar customer.lifecycle.created y customer.lifecycle.kyc con estado VERIFIED, correlationId y el mismo traceId. Las esperas humanas son huecos entre spans; no un span abierto. Sin un Trace ID seleccionado no se muestra una traza.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "${traceId}"
        }
      ],
      "options": {}
    }
  ]
}
