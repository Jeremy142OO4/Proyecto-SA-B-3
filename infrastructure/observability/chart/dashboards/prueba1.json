{
  "uid": "bank-usac-prueba1",
  "title": "Bank USAC-Prueba1",
  "schemaVersion": 39,
  "version": 17,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bank-usac",
    "customer-service",
    "prueba1",
    "account-service",
    "transaction-service",
    "payment-service"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bank_kyc_customers{service=\"customer-service\"}, environment)",
          "refId": "EnvironmentVariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "accountId",
        "label": "UUID de cuenta (.* = todas)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01/Customer_Service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Clientes verificados vs rechazados",
      "description": "Cantidad actual de clientes por estado KYC en la base. Incluye clientes anteriores y sobrevive reinicios. Se usa max para evitar duplicar el total compartido entre réplicas. Sin datos significa falta de telemetría; no equivale a cero clientes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (bank_kyc_customers{service=\"customer-service\",environment=\"$environment\",status=~\"VERIFIED|REJECTED\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VERIFIED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Verificados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REJECTED"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rechazados"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Creación → primera verificación KYC · p95 (24 h)",
      "description": "Percentil 95 estimado del histograma de tiempo desde creación hasta primera verificación. Cada punto utiliza verificaciones observadas en las últimas 24 horas, sumando buckets entre réplicas antes de calcular el percentil. No es duración de una consulta SQL ni promedio. Sin muestras aparece sin datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bank_kyc_duration_seconds_bucket{service=\"customer-service\",environment=\"$environment\"}[24h])))",
          "legendFormat": "Tiempo KYC p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 2,
          "noValue": "Sin verificaciones observadas",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trazas de creación y decisión KYC",
      "description": "Una fila por Trace ID, con creación y decisión KYC agrupadas. Expandir la fila para ver los spans y abrir el Trace ID para consultar el recorrido completo en Explore. El aviso root span not yet received puede aparecer en metadatos de búsqueda aunque la raíz esté disponible al abrir la traza.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"customer-service\" && resource.deployment.environment.name = \"$environment\" && name =~ \"customer[.]lifecycle[.](created|kyc)\" }",
          "limit": 20,
          "tableType": "traces",
          "spss": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "02/Account_service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Número de entradas y salidas por tipo de cuenta",
      "description": "Conteo entero de logs de movimientos confirmados en el rango seleccionado, por AHORRO/CORRIENTE/MONETARIA. CREDITO es entrada y DEBITO es salida. Si hay cinco logs de entradas se muestra 5, sin extrapolación ni redondear increase. Respeta UUID. Cuenta movimientos, no transferencias únicas. Sujeto a disponibilidad y retención de logs (48 h); no es un conteo histórico de SQL. Una combinación sin registros puede no aparecer. La consulta devuelve series numéricas de Loki; el panel toma la última muestra (final del rango) y la convierte a la tabla de categorías/operaciones. Las muestras anteriores no se suman.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (accountType, operation) (count_over_time({service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId!=\"\" | accountId=~\"${accountId:raw}\" | accountType=~\"AHORRO|CORRIENTE|MONETARIA\" | operation=~\"DEBITO|CREDITO\" [$__range]))",
          "queryType": "range",
          "legendFormat": "{{accountType}} · {{operation}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ],
            "includeTimeField": false
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Tipo de cuenta y operación",
              "Last *": "Operaciones",
              "Last": "Operaciones"
            },
            "excludeByName": {}
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Operaciones",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Tipo de cuenta y operación",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "maxDataPoints": 2
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Entradas y salidas por cuenta · conteo móvil",
      "description": "Conteo de movimientos por cuenta y operación en una ventana móvil del tamaño del rango del dashboard. Ejemplo: al seleccionar 1 h, cada punto cuenta los logs de la hora anterior a ese punto. La línea permanece mientras los eventos estén en esa ventana y disminuye al salir de ella. No es acumulado desde el inicio del rango ni saldo. Evita los puntos aislados del conteo por minuto. No se dibujan datos antes de observar actividad. UUID se extrae al consultar Loki, sin etiqueta en Prometheus. Retención: 48 h.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (accountId) (count_over_time({service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId=~\"${accountId:raw}\" | operation=\"CREDITO\" [$__range]))",
          "queryType": "range",
          "legendFormat": "Entradas · crédito · {{accountId}}"
        },
        {
          "refId": "B",
          "expr": "sum by (accountId) (count_over_time({service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId=~\"${accountId:raw}\" | operation=\"DEBITO\" [$__range]))",
          "queryType": "range",
          "legendFormat": "Salidas · débito · {{accountId}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never",
            "pointSize": 5,
            "lineWidth": 2,
            "spanNulls": false,
            "fillOpacity": 12,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Entradas.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Salidas.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Número de anomalías detectadas · ahorro, corriente y monetaria",
      "description": "Contador acumulado de detecciones por tipo de cuenta en las réplicas actuales, desde sus arranques. Se incrementa una vez por anomalía confirmada; el cooldown evita contar cada operación repetida como nueva alerta. Valores enteros sin extrapolar increase. Un reinicio o cambio de réplicas puede disminuir este total; no equivale al total histórico persistido ni al número de anomalías únicamente dentro del rango. Sin UUID en etiquetas. El filtro UUID no afecta este panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account_type) (bank_account_anomalies_total{service=\"account-service\",environment=\"$environment\",account_type=~\"AHORRO|CORRIENTE|MONETARIA\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{account_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 26,
      "type": "piechart",
      "title": "Transacciones y pagos completados · cuenta origen",
      "description": "Cantidad de transferencias y pagos completados durante el rango, desde logs de estado confirmados después del commit. Cada operación completada cuenta una vez; no se suman ambos movimientos de una transferencia. Excluye depósitos, rechazos y compensaciones. Respeta el UUID de la cuenta origen (.* = todas). El filtro por cuenta requiere las nuevas versiones de Payment/Transaction que incluyen accountId en sus logs. Logs antiguos sin accountId solo se incluyen al seleccionar todas las cuentas. Retención de Loki: 48 h.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"transaction-service\",deployment_environment_name=\"$environment\"} |= \"transfer state committed\" | json message=\"message\", state=\"state\", accountId=\"accountId\" | __error__=\"\" | accountId=~\"${accountId:raw}\" | message=\"transfer state committed\" | state=\"COMPLETADA\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "Transacciones (transferencias)"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"payment-service\",deployment_environment_name=\"$environment\"} |= \"payment state committed\" | json message=\"message\", state=\"state\", accountId=\"accountId\" | __error__=\"\" | accountId=~\"${accountId:raw}\" | message=\"payment state committed\" | state=\"COMPLETADO\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "Pagos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Transacciones (transferencias)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pagos"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 27,
      "type": "logs",
      "title": "Logs de actividad de cuentas",
      "description": "Vista compacta de logs originales con fecha, nivel y etiquetas, como el panel general de microservicios. Expandir una línea para ver accountId, accountType, operation y correlationId/traceId cuando existan; abrir TraceID para la traza. Filtrar UUID arriba (.* = todas). No se reescribe el JSON, para conservar el enlace Loki→Tempo. No añade accountId al índice ni a las métricas Prometheus. Hasta 100 líneas y 48 h de retención.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"account-service\",deployment_environment_name=\"$environment\"} |= \"account movement committed\" | json message=\"message\", accountId=\"accountId\", operation=\"operation\", accountType=\"accountType\" | __error__=\"\" | message=\"account movement committed\" | accountId!=\"\" | accountId=~\"${accountId:raw}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "03/Transaction_service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Latencia del flujo de transferencia · p50, p95 y p99",
      "description": "Percentiles estimados del histograma bank_transfer_flow_duration_seconds_bucket, en una ventana móvil de 5 minutos. Suma buckets de todas las réplicas y resultados antes de calcular cada percentil. Mide desde creación hasta resultado terminal confirmado e incluye validaciones, esperas del broker y compensaciones. No es promedio ni duración de una consulta SQL. Sin transferencias observadas o sin suficientes muestras de recolección aparece sin datos; no se sustituye por cero. El filtro UUID de Account Service no afecta este panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bank_transfer_flow_duration_seconds_bucket{service=\"transaction-service\",environment=\"$environment\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bank_transfer_flow_duration_seconds_bucket{service=\"transaction-service\",environment=\"$environment\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(bank_transfer_flow_duration_seconds_bucket{service=\"transaction-service\",environment=\"$environment\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "noValue": "Sin transferencias observadas",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Tasa de éxito y error de transferencias (%)",
      "description": "Comparación de resultados terminales en ventanas de 5 min: COMPLETADA es éxito; RECHAZADA/COMPENSADA/COMPENSACION_FALLIDA son fallo de la transferencia original. Cuando hay resultados observados, éxito + fallo suma 100%. Pendientes no entran en el denominador. Sin tráfico observado se deja un hueco, no se inventa éxito. Last muestra el último dato disponible y no significa necesariamente actividad en este instante.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 83,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * ((sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\",outcome=\"failure\"}[5m])) or (0 * sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])))) / sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])))) and (sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])) > 0)",
          "legendFormat": "Fallidas (%)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(100 * ((sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\",outcome=\"success\"}[5m])) or (0 * sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])))) / sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])))) and (sum(rate(bank_transfer_results_total{service=\"transaction-service\",environment=\"$environment\"}[5m])) > 0)",
          "legendFormat": "Exitosas (%)",
