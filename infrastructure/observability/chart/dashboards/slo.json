{
  "uid": "bank-slo",
  "title": "Bank USAC — SLO 99.5% y servicios",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Datos parciales no certifican 30 días. Sin tráfico: sin datos, nunca 100%. Retención limitada también por 2 GB. Alertas de ausencia no prueban una caída del servicio.",
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad HTTP observada (30 días); objetivo 99.5%",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\",status_class=\"5xx\"}[30d])) or vector(0)) / sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\"}[30d])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Presupuesto restante (solicitudes; puede ser negativo)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "0.005 * sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\"}[30d])) - (sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\",status_class=\"5xx\"}[30d])) or vector(0))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Solicitudes elegibles observadas (30 días)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\"}[30d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Respuestas 5xx observadas (30 días)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\",status_class=\"5xx\"}[30d])) or vector(0)) and (sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\"}[30d])) > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Burn rate 1h (1 = consumo sostenible)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\",status_class=\"5xx\"}[1h])) or vector(0)) / sum(increase(bank_http_requests_total{service=\"api-gateway\",environment=\"dev\",route!~\"/(health(/.*)?|healthz|salud|ready|readyz|metrics)\"}[1h])) / 0.005)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Historia TSDB disponible (no acredita cobertura completa del Gateway)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - prometheus_tsdb_lowest_timestamp_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "HTTP p95 por servicio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(bank_http_duration_seconds_bucket{environment=\"dev\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Gateway: p95 observado en 30 días (objetivo 500 ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (increase(bank_http_duration_seconds_bucket{service=\"api-gateway\",environment=\"dev\"}[30d])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Procesamiento RabbitMQ p95 por servicio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(bank_message_processing_seconds_bucket{environment=\"dev\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Clientes KYC por estado",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bank_kyc_customers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "KYC: decisiones por resultado",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(bank_kyc_decisions_total[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "KYC: creación hasta verificación p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(bank_kyc_duration_seconds_bucket[1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Cuentas: operaciones y anomalías detectadas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(__name__,account_type,direction) (increase({__name__=~\"bank_account_(movements|anomalies)_total\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
